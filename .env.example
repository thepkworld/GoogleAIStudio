# TMDB_API_KEY: Required for live The Movie Database (TMDB) movies, series, search, cast, and reviews.
# Add your complete TMDB Read Access Token (v4 Bearer) or API Key (v3) in the AI Studio Secrets panel.
# Note: Never commit your real .env file to version control.
TMDB_API_KEY=YOUR_TMDB_API_KEY

# OMDb API Key for Ratings (IMDb, Rotten Tomatoes, Metacritic), Awards, and automatic TMDB fallback
OMDB_API_KEY=YOUR_OMDB_API_KEY

# Optional Gemini key placeholder (unused in CinemaPaglu)
# GEMINI_API_KEY=MY_GEMINI_API_KEY
